{
  "version": 1,
  "description": "Cross-language contract fixture for a conversation's transcript. The Gateway writes every transcript a person downloads (backend/app/gateway/transcript.py); the page draws the same conversation (frontend-hm/src/core/messages/utils.ts). For each message, `visible` is whether the page draws it at all (not hidden from the UI, not a tool result), `content` is the text the page draws for it (inline reasoning removed), and `text` is what the transcript carries: that content with every backend-injected context marker removed as well, so no server path or memory leaves in a file. The page is tested on `visible` and `content`, the Gateway on all three. `internal_marker_tags` are the tags whose blocks the transcript removes; the page's `INTERNAL_MARKER_TAGS` and the Gateway's list both equal it.",
  "internal_marker_tags": [
    "current_uploads",
    "uploaded_files",
    "slash_skill_activation",
    "system-reminder",
    "memory",
    "current_date"
  ],
  "cases": [
    {
      "name": "plain user text",
      "message": {
        "id": "h-1",
        "type": "human",
        "content": "hello"
      },
      "visible": true,
      "content": "hello",
      "text": "hello"
    },
