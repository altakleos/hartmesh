HARTMESH_TENANT=example-tenant
HARTMESH_PUBLIC_HOST=tenant.example.com
HARTMESH_TRUSTED_PROXIES=192.0.2.10,192.0.2.11
HARTMESH_LISTEN=0.0.0.0:2026
HARTMESH_DATA_DIR=/srv/hartmesh
SANDBOX_RUNTIME=runsc
SANDBOX_EGRESS=allowlist
POSTGRES_PASSWORD=example-postgres-password
REDIS_PASSWORD=example-redis-password
AUTH_JWT_SECRET=example-session-signing-secret
# Sign-in mode (README: "Sign-in"). This example shows sign-on-only: the three keys below make the identity provider the one way in, with the callback https://<HARTMESH_PUBLIC_HOST>/api/v1/auth/callback/sso. Local passwords instead: remove them and set HARTMESH_LOCAL_PASSWORDS=allowed. Neither, both, or one or two of the three refuses to start.
HARTMESH_SIGN_ON_ISSUER=https://login.example.com/realms/tenant
HARTMESH_SIGN_ON_CLIENT_ID=hartmesh
HARTMESH_SIGN_ON_CLIENT_SECRET=example-sign-on-client-secret
# Optional, sign-on only (README: "Membership follows the claim"): admission follows one claim of the token, named literally, with the values that admit; HARTMESH_SIGN_ON_ROLES=<value>=admin,<value>=user makes the role follow it too (then HARTMESH_SIGN_ON_ADMINS must be unset). Absent, admission and roles are as before.
#HARTMESH_SIGN_ON_ACCESS_CLAIM=urn:example:workspace:roles
#HARTMESH_SIGN_ON_ACCESS_VALUES=admin,member
#HARTMESH_SIGN_ON_ROLES=admin=admin,member=user
# Provider keys the operator seeded for this tenant follow verbatim, any subset (possibly one) of the *_API_KEY names config.example.yaml references, e.g. OPENAI_API_KEY=..., ANTHROPIC_API_KEY=..., GEMINI_API_KEY=..., TAVILY_API_KEY=...
