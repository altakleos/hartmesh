{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartmesh.dev/contracts/business_report/report.schema.json",
  "title": "Business report draft",
  "description": "The single document the business-report skill's renderers read. Numbers are stored unformatted; one formatting function serves every renderer, so the HTML, PDF, DOCX and XLSX outputs agree by construction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meta",
    "kpis",
    "sections",
    "charts",
    "checks",
    "notes",
    "rows"
  ],
  "$defs": {
    "cell": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "currency",
        "integer",
        "number",
        "percent",
        "text",
        "date"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "not_checked"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "formats",
        "rows",
        "totals"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/format"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        },
        "totals": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "company",
        "period",
        "generated_at",
        "draft",
        "inputs",
        "profile",
        "preferences_applied",
        "lang",
        "currency",
        "build",
        "brand"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "label",
            "key"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "end": {
              "$ref": "#/$defs/date"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "draft": {
          "type": "integer",
          "minimum": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha256",
              "rows",
              "uploaded",
              "sheet"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "uploaded": {
                "$ref": "#/$defs/date"
              },
              "sheet": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "preferences_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "source"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "source": {
              "type": "string",
              "enum": [
                "header",
                "values",
                "mapping",
                "profile",
                "preferences",
                "assumed"
              ]
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "mapping",
            "exclusions"
          ],
          "description": "What produced this draft, so `checks` can be re-run and a rebuild can repeat the same choices.",
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mapping": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "equals"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  },
                  "equals": {
                    "type": "string"
                  }
                },
                "minProperties": 2,
                "maxProperties": 2
              }
            }
          }
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "company",
            "primary",
            "secondary",
            "logo"
          ],
          "properties": {
            "company": {
              "type": "string"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "logo": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "value",
          "format"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "format": {
            "$ref": "#/$defs/format"
          },
          "delta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vs",
              "pct"
            ],
            "properties": {
              "vs": {
                "type": "string",
                "minLength": 1
              },
              "pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "previous": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "$ref": "#/$defs/table"
          },
          "charts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "png",
          "spec"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "png": {
            "type": "string",
            "pattern": "^charts/[a-z0-9_]+\\.png$"
          },
          "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x",
              "y"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bar",
                  "barh",
                  "line"
                ]
              },
              "x": {
                "type": "string",
                "minLength": 1
              },
              "y": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "format": {
                "$ref": "#/$defs/format"
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "$ref": "#/$defs/table",
      "description": "The cleaned rows the report used: role columns first (date, amount, then the optional roles present), then the input's other columns untouched. The XLSX render's Summary formulas point at this sheet."
    }
  }
}
